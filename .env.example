# `docker compose up -d` starts this project's Postgres on 5435 (not the
# default 5432 — see docker-compose.yml for why). user/password: prosper/prosper.
DATABASE_URL="postgresql://prosper:prosper@localhost:5435/prosper?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
