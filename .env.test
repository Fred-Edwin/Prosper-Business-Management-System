# Test-suite database — isolated from the dev DB (`prosper_hotel`).
#
# `pnpm test` loads this file (via vitest.shared.ts) with override, so the
# suite never touches dev data. See docs/TESTING.md for how to create this
# database from scratch; `pnpm test` runs that setup automatically via the
# `pretest` script.
#
# Committed on purpose: it holds only a local connection string, no secrets,
# and a fresh clone needs it to run the suite.
#
# Port 5435 — this project's `docker-compose.yml` maps its Postgres there
# (not 5432) to avoid colliding with other projects' local Postgres
# containers on this machine. `docker compose up -d` starts it.
DATABASE_URL="postgresql://prosper:prosper@localhost:5435/prosper_hotel_tests?schema=public&connection_limit=5&pool_timeout=10"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-only-secret-not-used-for-anything-real"
