generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  admin
  store_manager
  cashier
  canteen_attendant
}

enum LocationType {
  restaurant
  canteen
  store
}

enum ProductKind {
  ingredient
  dish
  goods
}

enum MovementType {
  opening
  purchase_payment
  purchase_receipt
  issue
  production
  transfer
  sale
  non_sale_consumption
  stock_count
  closing
  // Stock that left one place and never arrived at the other — today only
  // written when a transfer is ACCEPTED SHORT (owner decision 2026-09-02,
  // F6). Before this, the missing units existed solely as free text on the
  // accept row, so system-wide stock silently dropped with no column able
  // to explain it. A `variance` row is signed like any other movement and
  // sums into the ledger's own column, so a daily reconciliation adds up.
  variance
}

enum NonSaleReason {
  staff_meal
  complimentary
  spoiled
  damaged
  other
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum PaymentMethod {
  cash
  mpesa
  credit
}

enum MoneyAccount {
  cash
  mpesa_bank
}

enum MoneySourceType {
  // The Admin's stated Day-1 cash / M-Pesa position (ADR-70). Money
  // balances are derived (ADR-17), so a "starting balance" can only be a
  // ledger row: `opening_balance` is the row that moves the derived
  // balance TO the stated figure. Dated to the first instant of its
  // business day, exactly as an `opening` StockMovement is (ADR-11).
  opening_balance
  handover_receipt
  expense
  purchase_payment
  owner_draw
  owner_return
  account_transfer
  order
  repayment
  canteen_sale
}

enum ExpenseCategory {
  rent
  utilities
  transport
  gas_fuel
  salaries
  repairs
  other
}

enum OwnerTransactionType {
  draw
  return
}

enum StaffPayAdjustmentType {
  advance
  deduction
}

/// How a staff member's monthly gross pay is computed (staff-pay rework
/// PR 2, ADR-76).
///   - `fixed_daily_rate` — the original model: gross = `dailyRate` ×
///     days present (from `Attendance`). The salaried manager / cashier
///     stay on this.
///   - `daily_entry` — the Admin types the day's amount per staff member
///     (`StaffDailyPay` rows). Attendance is still recorded and shown but
///     does NOT feed gross.
enum StaffPayModel {
  fixed_daily_rate
  daily_entry
}

enum AuditAction {
  create
  correct
  soft_delete
  hard_delete
  login
  day_close
  day_reopen
}

// ── Identity & Access ───────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String    @unique
  pinHash            String    @map("pin_hash")
  role               Role
  staffId            String?   @unique @map("staff_id")
  staff              Staff?    @relation(fields: [staffId], references: [id])
  active             Boolean   @default(true)
  failedPinAttempts  Int       @default(0) @map("failed_pin_attempts")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  stockMovementsRecorded StockMovement[]      @relation("StockMovementRecordedBy")
  ordersAsCashier        Order[]              @relation("OrderCashier")
  stockCountsCounted     StockCount[]         @relation("StockCountCountedBy")
  moneyMovementsRecorded MoneyMovement[]      @relation("MoneyMovementRecordedBy")
  receiptsOfHandover     ReceiptOfHandover[]  @relation("ReceiptRecordedBy")
  repaymentsRecorded     Repayment[]          @relation("RepaymentRecordedBy")
  expensesRecorded       Expense[]            @relation("ExpenseRecordedBy")
  staffPayoutsRecorded   StaffPayout[]        @relation("StaffPayoutRecordedBy")
  staffDailyPayRecorded  StaffDailyPay[]      @relation("StaffDailyPayRecordedBy")
  auditLogs              AuditLog[]           @relation("AuditLogUser")

  @@map("user")
}

model Staff {
  id         String   @id @default(uuid())
  name       String
  /// The app role this staff member signs in as. NULL for a roster-only
  /// staff member (a cook / casual who never uses the app) — such a row
  /// has `jobTitle` set instead and no linked `User`. Exactly one of
  /// (`role` + a `User`) or (`jobTitle`, no `User`) is set; enforced in
  /// `createStaff`, not the DB.
  role       Role?
  /// Free-text job description for a roster-only staff member ("Cook",
  /// "Casual"). NULL when `role` is set. Purely a display label — nothing
  /// branches on it.
  jobTitle   String?  @map("job_title")
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])
  dailyRate  Decimal  @map("daily_rate") @db.Decimal(12, 2)
  /// Which pay model this staff member is on (ADR-76). `fixed_daily_rate`
  /// (the default, today's behaviour) → gross = `dailyRate` × days
  /// present. `daily_entry` → gross = Σ `StaffDailyPay` rows for the
  /// month; `dailyRate` is unused for gross (kept for reference).
  payModel   StaffPayModel @default(fixed_daily_rate) @map("pay_model")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user                User?
  attendance          Attendance[]
  payAdjustments      StaffPayAdjustment[]
  dailyPay            StaffDailyPay[]
  payouts             StaffPayout[]
  handovers           Handover[]
  handoverShortfalls  HandoverShortfall[]

  @@map("staff")
}

// ── Locations & Catalog ─────────────────────────────────────────────────

model Location {
  id        String       @id @default(uuid())
  name      String
  type      LocationType
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  staff                    Staff[]
  productLocations         ProductLocation[]
  stockMovements           StockMovement[]          @relation("StockMovementLocation")
  stockMovementsCounterpart StockMovement[]         @relation("StockMovementTransferCounterpart")
  orders                   Order[]
  stockCounts              StockCount[]
  handovers                Handover[]
  assets                   Asset[]

  @@map("location")
}

model Product {
  id           String      @id @default(uuid())
  name         String
  kind         ProductKind
  // Admin-set menu category (Mains / Sides / Drinks / Snacks …). Powers
  // the C2 New-Order product grid + K1 Stock-Count picker category tab
  // rows (M2-01 §6/§10; owner-approved into M2 Session 6). Free-text,
  // optional — a product with none groups under an "Uncategorised" tab.
  category     String?
  buyingPrice  Decimal?    @map("buying_price") @db.Decimal(12, 2)
  unitLabel    String      @map("unit_label")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  productLocations   ProductLocation[]
  stockMovements     StockMovement[]
  orderLines         OrderLine[]
  stockCounts        StockCount[]
  recipe             Recipe?
  recipeIngredientOf RecipeIngredient[]

  @@map("product")
}

model ProductLocation {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  locationId    String   @map("location_id")
  location      Location @relation(fields: [locationId], references: [id])
  sellingPrice  Decimal? @map("selling_price") @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([productId, locationId])
  @@map("product_location")
}

// ── Recipes (informational only — ADR-33) ──────────────────────────────

model Recipe {
  id             String   @id @default(uuid())
  dishProductId  String   @unique @map("dish_product_id")
  dishProduct    Product  @relation(fields: [dishProductId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ingredients RecipeIngredient[]

  @@map("recipe")
}

model RecipeIngredient {
  id                   String   @id @default(uuid())
  recipeId             String   @map("recipe_id")
  recipe               Recipe   @relation(fields: [recipeId], references: [id])
  ingredientProductId  String   @map("ingredient_product_id")
  ingredientProduct    Product  @relation(fields: [ingredientProductId], references: [id])
  quantityPerUnit      Decimal  @map("quantity_per_unit") @db.Decimal(12, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("recipe_ingredient")
}

// ── Stock Ledger ─────────────────────────────────────────────────────────

model StockMovement {
  id         String        @id @default(uuid())
  productId  String        @map("product_id")
  product    Product       @relation(fields: [productId], references: [id])
  locationId String        @map("location_id")
  location   Location      @relation("StockMovementLocation", fields: [locationId], references: [id])

  movementType MovementType @map("movement_type")
  quantity     Decimal      @db.Decimal(14, 4)

  recordedById String   @map("recorded_by")
  recordedBy   User     @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  occurredAt DateTime @map("occurred_at")

  reason     NonSaleReason?
  reasonNote String?        @map("reason_note")

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  stockCountId String?     @map("stock_count_id")
  stockCount   StockCount? @relation(fields: [stockCountId], references: [id])

  transferCounterpartLocationId String?   @map("transfer_counterpart_location_id")
  transferCounterpartLocation   Location? @relation("StockMovementTransferCounterpart", fields: [transferCounterpartLocationId], references: [id])

  purchasePaymentId String? @map("purchase_payment_id")

  // Real purchase-payment detail (ADR-46 §3). All nullable; set only for
  // `movementType = "purchase_payment"`. Before ADR-46 these lived in a
  // free-text `note` scraped by a client-side regex (`parsePaymentNote`).
  purchaseSupplier   String?  @map("purchase_supplier")
  purchaseOrderedQty Decimal? @map("purchase_ordered_qty") @db.Decimal(14, 4)
  purchaseTotalCost  Decimal? @map("purchase_total_cost") @db.Decimal(14, 2)
  purchasePaidFrom   String?  @map("purchase_paid_from") // "cash" | "mpesa_bank"

  // The product's catalog `buyingPrice` immediately before this payment
  // overwrote it (`recordPurchasePayment` sets the price to cost / qty).
  // `voidPurchasePayment` rolls the price back to this. `purchase_payment`
  // rows only; null on a payment recorded before this column existed.
  purchasePriorBuyingPrice Decimal? @map("purchase_prior_buying_price") @db.Decimal(14, 2)

  correctsMovementId String?         @map("corrects_movement_id")
  correctsMovement   StockMovement?  @relation("StockMovementCorrection", fields: [correctsMovementId], references: [id])
  corrections        StockMovement[] @relation("StockMovementCorrection")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  moneyMovements MoneyMovement[]

  @@map("stock_movement")
}

// ── Restaurant Sales ─────────────────────────────────────────────────────

model Order {
  id         String   @id @default(uuid())
  // Human-readable, monotonic order number ("#1043") — what staff and the
  // Admin say out loud and what A2/A3/C1/C4 render. A correction is its
  // own Order row and gets its own number; `correctsOrderId` links the
  // pair. Postgres sequence (owner-approved into M2 Session 6).
  number     Int      @unique @default(autoincrement())
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  cashierId String @map("cashier_id")
  cashier   User   @relation("OrderCashier", fields: [cashierId], references: [id])

  orderType     OrderType     @map("order_type")
  deliveryFee   Decimal?      @map("delivery_fee") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  total Decimal @db.Decimal(12, 2)

  // The order's business instant (Africa/Nairobi day boundary, ADR-29).
  // Defaults to creation time; may be backdated by a correction so the
  // correcting row lands in the same business day as the original. The
  // edit-vs-correct gate (M2 soft check; M3 real DayClose) compares this
  // order's business date to today. Every other ledger table carries the
  // same `occurred_at` (StockMovement, StockCount, MoneyMovement, Debt…).
  occurredAt DateTime @default(now()) @map("occurred_at")

  correctsOrderId String? @map("corrects_order_id")
  correctsOrder   Order?  @relation("OrderCorrection", fields: [correctsOrderId], references: [id])
  corrections     Order[] @relation("OrderCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines          OrderLine[]
  stockMovements StockMovement[]
  debts          Debt[]

  @@map("order")
}

model OrderLine {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_line")
}

// ── Canteen Derived Sales ────────────────────────────────────────────────

model StockCount {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  countedById String @map("counted_by")
  countedBy   User   @relation("StockCountCountedBy", fields: [countedById], references: [id])

  countedQuantity Decimal  @map("counted_quantity") @db.Decimal(14, 4)
  occurredAt      DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]

  @@map("stock_count")
}

// ── Money Ledger ──────────────────────────────────────────────────────────

model MoneyMovement {
  id      String       @id @default(uuid())
  account MoneyAccount
  amount  Decimal      @db.Decimal(12, 2)

  sourceType MoneySourceType @map("source_type")
  sourceId   String?         @map("source_id")

  stockMovementId String?        @map("stock_movement_id")
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id])

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("MoneyMovementRecordedBy", fields: [recordedById], references: [id])

  occurredAt DateTime @map("occurred_at")

  correctsMovementId String?          @map("corrects_movement_id")
  correctsMovement   MoneyMovement?   @relation("MoneyMovementCorrection", fields: [correctsMovementId], references: [id])
  corrections        MoneyMovement[]  @relation("MoneyMovementCorrection")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("money_movement")
}

// ── Handover & Reconciliation ────────────────────────────────────────────

model Handover {
  id         String   @id @default(uuid())
  staffId    String   @map("staff_id")
  staff      Staff    @relation(fields: [staffId], references: [id])
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  cashDeclared  Decimal  @map("cash_declared") @db.Decimal(12, 2)
  mpesaDeclared Decimal  @map("mpesa_declared") @db.Decimal(12, 2)
  occurredAt    DateTime @map("occurred_at")

  correctsHandoverId String?    @map("corrects_handover_id")
  correctsHandover   Handover?  @relation("HandoverCorrection", fields: [correctsHandoverId], references: [id])
  corrections        Handover[] @relation("HandoverCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receipts ReceiptOfHandover[]

  @@map("handover")
}

model ReceiptOfHandover {
  id         String   @id @default(uuid())
  handoverId String   @map("handover_id")
  handover   Handover @relation(fields: [handoverId], references: [id])

  cashReceived  Decimal @map("cash_received") @db.Decimal(12, 2)
  mpesaReceived Decimal @map("mpesa_received") @db.Decimal(12, 2)
  cashVariance  Decimal @map("cash_variance") @db.Decimal(12, 2)
  mpesaVariance Decimal @map("mpesa_variance") @db.Decimal(12, 2)

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("ReceiptRecordedBy", fields: [recordedById], references: [id])

  occurredAt DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shortfalls HandoverShortfall[]

  @@map("receipt_of_handover")
}

// ── Customers & Credit ───────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders      Order[]
  debts       Debt[]
  repayments  Repayment[]

  @@map("customer")
}

model Debt {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("debt")
}

model Repayment {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)

  // Which money account the repayment landed in ("cash" | "mpesa_bank")
  // and an optional free-text note. The paired `MoneyMovement` also
  // records the account; storing it here lets `getCustomerLedger` render
  // the A2 "Reference" cell ("Cash" / "M-Pesa" / the note) without a join.
  // (owner-approved into M2 Session 6.)
  account MoneyAccount @default(cash)
  note    String?

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("RepaymentRecordedBy", fields: [recordedById], references: [id])

  occurredAt DateTime @map("occurred_at")

  // Append-only correction link (ADR-15). A correction is a new signed
  // `Repayment` row carrying the delta, pointing at the original; the
  // original is never mutated. `correctRepayment` / `voidRepayment`.
  correctsRepaymentId String?     @map("corrects_repayment_id")
  correctsRepayment   Repayment?  @relation("RepaymentCorrection", fields: [correctsRepaymentId], references: [id])
  corrections         Repayment[] @relation("RepaymentCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("repayment")
}

// ── Expenses & Owner Transactions ────────────────────────────────────────

model Expense {
  id              String          @id @default(uuid())
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(12, 2)
  date            DateTime
  paidFromAccount MoneyAccount    @map("paid_from_account")
  note            String?

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  correctsExpenseId String?   @map("corrects_expense_id")
  correctsExpense   Expense?  @relation("ExpenseCorrection", fields: [correctsExpenseId], references: [id])
  corrections       Expense[] @relation("ExpenseCorrection")

  staffPayout StaffPayout? @relation("StaffPayoutExpense")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expense")
}

model OwnerTransaction {
  id     String               @id @default(uuid())
  type   OwnerTransactionType
  amount Decimal              @db.Decimal(12, 2)
  date   DateTime
  note   String?

  // Append-only correction link (ADR-15). A correction is a new
  // `OwnerTransaction` row carrying the signed delta (and possibly a
  // flipped `type`), pointing at the original; the original is never
  // mutated. `correctOwnerTransaction` / `voidOwnerTransaction`.
  correctsOwnerTransactionId String?            @map("corrects_owner_transaction_id")
  correctsOwnerTransaction   OwnerTransaction?  @relation("OwnerTransactionCorrection", fields: [correctsOwnerTransactionId], references: [id])
  corrections                OwnerTransaction[] @relation("OwnerTransactionCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("owner_transaction")
}

// ── Staff, Attendance, Pay ───────────────────────────────────────────────

model Attendance {
  id      String   @id @default(uuid())
  staffId String   @map("staff_id")
  staff   Staff    @relation(fields: [staffId], references: [id])
  date    DateTime @db.Date
  present Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([staffId, date])
  @@map("attendance")
}

model StaffPayAdjustment {
  id      String                  @id @default(uuid())
  staffId String                  @map("staff_id")
  staff   Staff                   @relation(fields: [staffId], references: [id])
  type    StaffPayAdjustmentType
  /// Signed magnitude. A recorded advance/deduction is stored positive
  /// (the sign is implied by `type` and applied at read time). A
  /// **correction** row (`correctsAdjustmentId` set) carries the signed
  /// DELTA — it may be negative — and keeps the original's `type` so a
  /// plain per-type sum in `getStaffPay` folds it in (ADR-72). Unlike
  /// every other ADR-72 correction, this writes NO `MoneyMovement`: an
  /// advance/deduction only nets the derived pay figure at read time, it
  /// is not a cash-ledger event until a payout is recorded.
  amount  Decimal                 @db.Decimal(12, 2)
  date    DateTime                @db.Date
  note    String?

  // Append-only correction link (ADR-15 / ADR-72). A correction is a new
  // `StaffPayAdjustment` row carrying the signed delta, pointing at the
  // original; the original is never mutated. `correctPayAdjustment` /
  // `voidPayAdjustment`. Corrections never chain.
  correctsAdjustmentId String?              @map("corrects_adjustment_id")
  correctsAdjustment   StaffPayAdjustment?  @relation("StaffPayAdjustmentCorrection", fields: [correctsAdjustmentId], references: [id])
  corrections          StaffPayAdjustment[] @relation("StaffPayAdjustmentCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff_pay_adjustment")
}

/// One hand-typed daily pay amount for a `daily_entry` staff member
/// (staff-pay rework PR 2, ADR-76). Append-only, like `StaffPayAdjustment`:
///
///   - an ORIGINAL row (`correctsDailyPayId` null) is one (staff, business
///     date) entry — "today this person gets KES X". At most one original
///     per staff-day, enforced by a PARTIAL unique index
///     `WHERE corrects_daily_pay_id IS NULL` (Prisma has no partial-index
///     syntax — plain `@@index` here, the unique lives in raw SQL, same
///     trick as migration 20260908130000).
///   - a CORRECTION row (`correctsDailyPayId` set) carries the signed
///     DELTA (may be negative) and points at the original; `getStaffPay`
///     sums originals + deltas so a corrected / voided entry folds in.
///
/// Day-close gated on write (`assertDayOpen(date)`), exactly like
/// `recordPayAdjustment`. Writes NO `MoneyMovement` — a pay entry is not a
/// cash event until a payout is recorded (`payStaff`).
model StaffDailyPay {
  id      String   @id @default(uuid())
  staffId String   @map("staff_id")
  staff   Staff    @relation(fields: [staffId], references: [id])
  /// The day's pay. An original is > 0; a correction row's signed delta
  /// may be negative. Decimal(12,2).
  amount  Decimal  @db.Decimal(12, 2)
  /// The business date this pay is for (`@db.Date`, Africa/Nairobi).
  date    DateTime @db.Date
  note    String?

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("StaffDailyPayRecordedBy", fields: [recordedById], references: [id])

  // Append-only correction link (ADR-15 / ADR-72). A correction is a new
  // `StaffDailyPay` row carrying the signed delta, pointing at the
  // original; the original is never mutated. `correctDailyPay` /
  // `voidDailyPay`. Corrections never chain.
  correctsDailyPayId String?         @map("corrects_daily_pay_id")
  correctsDailyPay   StaffDailyPay?  @relation("StaffDailyPayCorrection", fields: [correctsDailyPayId], references: [id])
  corrections        StaffDailyPay[] @relation("StaffDailyPayCorrection")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // At most one ORIGINAL entry per staff-day — a PARTIAL unique index
  // (`WHERE corrects_daily_pay_id IS NULL`) created in the migration.
  @@index([staffId, date])
  @@map("staff_daily_pay")
}

/// A staff member's monthly pay actually disbursed (M4 S9A). Recording one
/// creates ONE Salaries `Expense` (via `recordExpense`) — that expense
/// writes the paired negative `MoneyMovement`, so cash and Net Profit drop
/// exactly once through the already-tested path. There is no bespoke
/// MoneyMovement here. `netPaid` is recomputed server-side from the ledger
/// at record time (never client-supplied). One payout per (staff, month) —
/// enforced by the DB unique below, not just in code (ADR-60).
model StaffPayout {
  id    String   @id @default(uuid())
  staffId String @map("staff_id")
  staff Staff    @relation(fields: [staffId], references: [id])
  /// The calendar month covered, stored as the 1st of that month (`@db.Date`).
  month DateTime @db.Date
  /// Net pay disbursed — recomputed from the ledger, always > 0.
  netPaid Decimal @map("net_paid") @db.Decimal(12, 2)
  /// The business date the disbursement is dated to (day-close gated).
  date  DateTime @db.Date
  paidFromAccount MoneyAccount @map("paid_from_account")

  recordedById String @map("recorded_by")
  recordedBy   User   @relation("StaffPayoutRecordedBy", fields: [recordedById], references: [id])

  /// The Salaries `Expense` this payout created. 1:1 — the expense carries
  /// the money/profit effect; this row records that the month was paid.
  expenseId String  @unique @map("expense_id")
  expense   Expense @relation("StaffPayoutExpense", fields: [expenseId], references: [id])

  /// Set by `reversePayout` (ADR-73) when a payout is undone: the offsetting
  /// Expense delta row + paired MoneyMovement are written elsewhere, this
  /// row is stamped and thereafter ignored by `getStaffPay` /
  /// `getPayrollSummary` / `payStaff`, so the staff-month is payable again.
  reversedAt DateTime? @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // At most one LIVE (non-reversed) payout per staff-month. Enforced by a
  // PARTIAL unique index (`WHERE reversed_at IS NULL`) created in migration
  // 20260908130000 — Prisma has no partial-index syntax, so this is a
  // plain index here and the partial unique lives in raw SQL.
  @@index([staffId, month])
  @@map("staff_payout")
}

model HandoverShortfall {
  id                  String            @id @default(uuid())
  receiptOfHandoverId String            @map("receipt_of_handover_id")
  receiptOfHandover   ReceiptOfHandover @relation(fields: [receiptOfHandoverId], references: [id])
  staffId             String            @map("staff_id")
  staff               Staff             @relation(fields: [staffId], references: [id])
  note                String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("handover_shortfall")
}

// ── Assets ────────────────────────────────────────────────────────────────

model Asset {
  id               String    @id @default(uuid())
  name             String
  locationId       String    @map("location_id")
  location         Location  @relation(fields: [locationId], references: [id])
  purchaseDate     DateTime  @map("purchase_date") @db.Date
  purchaseCost     Decimal   @map("purchase_cost") @db.Decimal(12, 2)
  conditionStatus  String    @map("condition_status")
  deletedAt        DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("asset")
}

// ── Day Close ─────────────────────────────────────────────────────────────

model DayClose {
  id       String   @id @default(uuid())
  date     DateTime @unique @db.Date
  closedBy String   @map("closed_by")
  closedAt DateTime @default(now()) @map("closed_at")

  @@map("day_close")
}

// ── Audit Trail ───────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation("AuditLogUser", fields: [userId], references: [id])
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  occurredAt DateTime    @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
